[1;37m    tro [1;36m= transfer troops       [1;37mdec [1;36m= transfer decoys
[1;37m    mis [1;36m= transfer missiles     [1;37mmin [1;36m= transfer mines
[1;37m    tor [1;36m= transfer torpedoes    [1;37mjam [1;36m= transfer jammers
[1;37m    ion [1;36m= transfer ion cannons  [1;37mzip [1;36m= transfer zippers
[1;37m    flu [1;36m= transfer flux pods    [1;37mgol [1;36m= transfer gold
[1;37m    foo [1;36m= transfer food         [1;37mspy [1;36m= transfer spies

