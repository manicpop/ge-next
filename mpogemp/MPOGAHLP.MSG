[1;37m  sys get [1;32m[amount] [item][1;36m -- get this many items, regardless of cargo size
[1;37m  sys kill [1;32m[user][1;36m -- destroy the ship of the user specified
[1;37m  sys goto [1;32m[sector][1;36m -- teleport to this sector
[1;37m  sys class [1;32m[number][1;36m -- change current ship to specified class number
[1;37m  sys shieldtype [1;32m[number][1;36m -- change current ship shield to specified class
